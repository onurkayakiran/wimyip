# Merkezi remote-api servisinin adresi (TLS ile, /admin panelinden reverse
# proxy/subdomain kurulumu sonrasi aliniz).
CENTRAL_API_URL=https://remote-api.example.com

# /admin panelinde "Uzak Workerlar" bolumunden bu lokasyon icin uretilen
# token. docker-compose.yml'deki uc servis (worker-ptr/worker-dns/worker-dns-apex)
# ayni token'i paylasir - token olustururken ucunun de kuyugunu (ptr_sweep,
# dns_history, dns_history_apex) isaretleyip TEK token uretin. Sadece bu
# makinede saklanir, baska hicbir sir icermez.
REMOTE_API_TOKEN=change_me_after_minting_in_admin_panel

# NOT: QUEUE burada DEGIL, docker-compose.yml'de servis basina tanimli
# (worker-ptr icin ptr_sweep, worker-dns icin dns_history, worker-dns-apex
# icin dns_history_apex) - hepsinin ayni anda calismasini istemiyorsaniz
# docker-compose.yml'den istemediginiz servisi silin.

BATCH_SIZE=200
RATE_LIMIT_SECONDS=0.1
POLL_INTERVAL_SECONDS=5

# Bos ise bu sunucunun kendi sistem/ISP resolver'i kullanilir; guvenilmezse
# sabit bir genel resolver verin (orn. 1.1.1.1).
DNS_RESOLVER=

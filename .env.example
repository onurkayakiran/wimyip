# MongoDB — bu proje kendi mongod'unu calistirmaz, harici (kendi
# sunucunuz, Atlas, baska bir yonetilen servis vb.) bir MongoDB'ye baglanir.
# Tam baglanti string'ini buraya yazin (mongodb+srv:// de desteklenir).
# Hedef sunucuda bu kullanici/veritabani onceden olusturulmus olmali - bu
# proje MONGO_INITDB_ROOT_* ile otomatik kullanici olusturmaz.
# NOT: mongo AYNI fiziksel sunucuda ama AYRI bir docker-compose projesinde
# (orn. mongo-external/) calisiyorsa host olarak "localhost" YAZMAYIN -
# container'in kendi loopback'i olur, mongo'ya ulasmaz. Bunun yerine
# "host.docker.internal" kullanin (docker-compose.yml'deki extra_hosts:
# host-gateway sayesinde bu, host makinenin kendisine cozulur).
MONGO_URI=mongodb://kullanici:sifre@mongo-sunucunuz:27017/ipasn?authSource=admin
MONGO_DB=ipasn
# backup servisinin mongodump/mongorestore araclarini harici MongoDB
# sunucunuzun surumuyle uyumlu tutmak icin (orn. sunucunuz 4.4 ise burayi
# da 4.4 yapin).
MONGO_IMAGE_TAG=7

# Port mapping (host tarafinda)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Yonetim sayfasi (/admin) - servis durumu/loglarini gorme, servisleri
# yeniden baslatma. Mutlaka degistirin, bu sayfa herkese acik bir parola
# ile korunuyor (baska bir auth katmani yok).
ADMIN_PASSWORD=change_me_please
# control servisi (docker.sock erisimi olan izole servis) ile backend
# arasindaki paylasilan sir - rastgele uzun bir deger verin, orn:
# openssl rand -hex 32
CONTROL_SERVICE_TOKEN=change_me_please

# Otomatik yedekleme (backup servisi)
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7

# ==========================================================================
# Arka plan tarama hizi (degistirdikten sonra: docker compose up -d --build)
# ==========================================================================

# --- PTR (reverse DNS) taramasi ---
# Kendi Unbound resolver'imiz uzerinden calisir - PAYLASILAN bir kaynaga
# bagimli degil, bu yuzden asagidakiler rahatca artirilabilir/dusurulebilir.
# Hizlandirmak icin: PTR_WORKER_CONCURRENCY'i artirin (paralel IP araligi
# taranir) VE/VEYA PTR_RATE_LIMIT_SECONDS'i dusurun VE/VEYA PTR_BATCH_SIZE'i
# artirin. Ana maliyet: daha fazla CPU/ag kullanimi ve karsi taraf DNS
# sunucularina daha sik sorgu.
PTR_WORKER_CONCURRENCY=1
PTR_BATCH_SIZE=500
PTR_RATE_LIMIT_SECONDS=0.1
PTR_SWEEP_INTERVAL_SECONDS=60

# --- Ulke bazli PTR taramasi (ayri container: ptr-worker-country) ---
# ISO 3166-1 alpha-2 kod (RIR verisindeki ham kod, orn "TR"). Global
# ptr-worker'dan tamamen bagimsiz calisir, kendi cursor'unu tutar - baska
# bir ulke icin ikinci bir servis+TARGET_COUNTRY ile bu desen kopyalanabilir.
TARGET_COUNTRY=TR
COUNTRY_PTR_BATCH_SIZE=500
COUNTRY_PTR_RATE_LIMIT_SECONDS=0.1
COUNTRY_SWEEP_INTERVAL_SECONDS=60

# --- Ulke bazli APEX (ana, subdomain olmayan) domain taramasi ---
# (ayri container: apex-worker-country)
APEX_COUNTRY_BATCH_SIZE=50
APEX_COUNTRY_DOMAINS_PER_PREFIX=200
APEX_COUNTRY_RATE_LIMIT_SECONDS=0.2
APEX_COUNTRY_SWEEP_INTERVAL_SECONDS=120

# --- Certificate Transparency (CT) log senkronu ---
# crt.sh herkese acik, PAYLASILAN bir veritabanidir. Buradakileri agresif
# artirmak crt.sh'yi zorlayabilir veya bizi engellenmeye maruz birakabilir -
# olculu artirin (orn. batch'i 2-3 katina cikarmak, interval'i 60sn'ye
# indirmek reeldir; 10x gibi degerlerden kacinin).
CT_BATCH_SIZE=500
CT_LOG_SYNC_INTERVAL_SECONDS=120

# --- Bilinen domainlerin DNS (A/AAAA/NS) gecmisini yeniden dogrulama ---
DNS_HISTORY_BATCH_SIZE=100
DNS_HISTORY_RATE_LIMIT_SECONDS=0.2
DNS_HISTORY_SYNC_INTERVAL_SECONDS=300

# --- RDAP (whois) sahiplik zenginlestirme ---
# Her RIR'in kendi RDAP servisine gider - asiri artirmak o RIR'lar
# tarafindan rate-limit'e takilmaniza yol acabilir.
RDAP_BATCH_SIZE=100
RDAP_RATE_LIMIT_SECONDS=1.0
RDAP_SYNC_INTERVAL_SECONDS=300

# --- RIPEstat (BGP duyuru gecmisi) ---
RIPESTAT_BATCH_SIZE=50
RIPESTAT_RATE_LIMIT_SECONDS=0.5
BGP_SYNC_INTERVAL_SECONDS=300

# --- PeeringDB (ASN/org profili) ---
PEERINGDB_BATCH_SIZE=100
PEERINGDB_RATE_LIMIT_SECONDS=1.0
PEERINGDB_SYNC_INTERVAL_SECONDS=300

# --- Genel worker concurrency ---
# Bu kuyrukta 6 farkli periyodik gorev var (rdap-asn, rdap-prefix, bgp,
# peeringdb, ct-log, dns-history) - dusuk tutarsaniz sik calisan gorevler
# (orn. ct-log, 2 dk) diger gorevlerin ac kalmasina yol acabilir.
WORKER_CONCURRENCY=6
